{
  "$name": "eMOBIQ · ETD·ERM Design Tokens",
  "$theme": "dark",
  "$note": "Semantic values are resolved to their final value. 'alias' shows the primitive/semantic token each one points to in the CSS source.",
  "color": {
    "primitive": {
      "brand-500": "#FF5F24",
      "brand-600": "#D95726",
      "slate-50": "#F8FAFC",
      "slate-100": "#F1F5F9",
      "slate-200": "#E2E8F0",
      "slate-500": "#64748B",
      "slate-700": "#334155",
      "slate-800": "#1E293B",
      "slate-900": "#0F172A",
      "slate-950": "#020617",
      "ink-50": "#F1F5FC",
      "ink-300": "#BCC3CD",
      "ink-400": "#99A1AB",
      "ink-500": "#6E757F",
      "ink-600": "#515760",
      "teal-500": "#4DD4AC",
      "red-500": "#DC3545",
      "blue-400": "#3D8BFD"
    },
    "surface": {
      "canvas":     { "value": "#0F172A", "alias": "slate-900" },
      "base":       { "value": "#1E293B", "alias": "slate-800" },
      "subtle":     { "value": "#334155", "alias": "slate-700" },
      "raised":     { "value": "#64748B", "alias": "slate-500" },
      "floating":   { "value": "#334155", "alias": "slate-700" },
      "brand":      { "value": "#FF5F24", "alias": "brand-500" },
      "brand-emph": { "value": "#D95726", "alias": "brand-600" },
      "inverse":    { "value": "#F8FAFC", "alias": "slate-50" },
      "card":       { "value": "rgba(255,255,255,0.05)" }
    },
    "text": {
      "primary":      { "value": "#F1F5FC", "alias": "ink-50" },
      "secondary":    { "value": "#BCC3CD", "alias": "ink-300" },
      "tertiary":     { "value": "#99A1AB", "alias": "ink-400" },
      "placeholder":  { "value": "#6E757F", "alias": "ink-500" },
      "quaternary":   { "value": "#515760", "alias": "ink-600" },
      "disabled":     { "value": "#515760", "alias": "ink-600" },
      "on-emphasis":  { "value": "#FFFFFF" },
      "inverse":      { "value": "#0F172A", "alias": "slate-900" },
      "brand":        { "value": "#FF5F24", "alias": "brand-500" }
    },
    "border": {
      "subtle":   { "value": "rgba(255,255,255,0.10)" },
      "normal":   { "value": "rgba(255,255,255,0.20)" },
      "strong":   { "value": "rgba(255,255,255,0.30)" },
      "brand":    { "value": "#FF5F24", "alias": "brand-500" },
      "focus":    { "value": "#3D8BFD", "alias": "blue-400" }
    },
    "status": {
      "success": { "value": "#4DD4AC", "alias": "teal-500" },
      "error":   { "value": "#DC3545", "alias": "red-500" }
    },
    "action": {
      "secondary-hover":  { "value": "rgba(255,255,255,0.08)" },
      "secondary-active": { "value": "rgba(255,255,255,0.20)" }
    },
    "figma": {
      "bg-main":      "#141414",
      "bg-rail-top":  "#262626",
      "bg-rail-btm":  "#733B26",
      "bg-plate-dk":  "#1F1F1F",
      "border-lv1":   "#474747",
      "border-lv2":   "#575659",
      "border-hover": "#666666",
      "toggle-off":   "#454547",
      "toggle-thumb": "#FFFFFF",
      "icon-bg":      "#333333"
    }
  },
  "space": {
    "4": "4px", "8": "8px", "12": "12px", "16": "16px", "20": "20px",
    "24": "24px", "28": "28px", "32": "32px", "36": "36px", "40": "40px"
  },
  "radius": {
    "xs": "2px", "sm": "4px", "md": "6px", "lg": "8px",
    "xl": "12px", "2xl": "20px", "full": "9999px"
  },
  "borderWidth": {
    "hairline": "1px",
    "thin": "2px"
  },
  "controlHeight": {
    "xs": "24px", "sm": "32px", "md": "40px", "lg": "48px", "xl": "56px"
  },
  "font": {
    "family": "Poppins, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif"
  },
  "type": {
    "display":    { "fontSize": "28px", "lineHeight": "36px", "fontWeight": 600 },
    "h1":         { "fontSize": "24px", "lineHeight": "32px", "fontWeight": 600 },
    "h2":         { "fontSize": "20px", "lineHeight": "28px", "fontWeight": 600 },
    "h3":         { "fontSize": "16px", "lineHeight": "24px", "fontWeight": 600 },
    "body":       { "fontSize": "14px", "lineHeight": "20px", "fontWeight": 400 },
    "body-md":    { "fontSize": "14px", "lineHeight": "20px", "fontWeight": 500 },
    "body-sb":    { "fontSize": "14px", "lineHeight": "20px", "fontWeight": 600 },
    "caption":    { "fontSize": "12px", "lineHeight": "16px", "fontWeight": 400 },
    "caption-sb": { "fontSize": "12px", "lineHeight": "16px", "fontWeight": 600 },
    "footnote":   { "fontSize": "11px", "lineHeight": "16px", "fontWeight": 400 }
  },
  "acceptedRawBackgrounds": {
    "$note": "Background colors are exempt from tokenization; used as-is for Figma-specific surfaces.",
    "modal-canvas": "#1A1A1A",
    "sidebar": "#262626",
    "card": "#2B2B2B",
    "inset-build-card": "#2E2E2E",
    "panel-rail": "#242424",
    "deep-panel": "#191919",
    "workspace-header": "#343138",
    "checkpoint-banner": "#2C2932",
    "badge-active-tab": "#424242",
    "avatar": "#4D4D4D"
  },
  "statusPill": {
    "success": { "background": "#79DFC1", "text": "#13795B" }
  },
  "terminalSyntax": {
    "path": "#99E2FF",
    "prompt": "#C55CE5",
    "ok": "#52CC9D"
  }
}
